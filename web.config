<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config for svanidhi.pnb.bank.in web application.

  Goal: Make short 40-char SMS URL work → https://svanidhi.pnb.bank.in/d/{token}

  HOW IT WORKS (NO extra IIS modules needed):
  ─────────────────────────────────────────────────────────────────
  1. <handlers> entry below tells IIS to send any request
     matching path "d/*" directly to the DownloadDoc class.
     This is BUILT INTO IIS 7+ integrated pipeline — no plugins.

  2. DownloadDoc.ashx reads the token from Request.PathInfo
     e.g. GET /d/A3kZ9mQ1r → PathInfo = "/A3kZ9mQ1r" → token = "A3kZ9mQ1r"

  3. Handler validates token in DB (expiry + click count) and serves PDF.

  URL LENGTH CHECK:
     https://svanidhi.pnb.bank.in/d/  =  31 chars
     {9-char token}                   =   9 chars
                                         ────────
     TOTAL                            =  40 chars ✓  (ValueFirst limit = 40)

  SERVER REQUIREMENT:
     IIS 7+ running in Integrated Pipeline mode (standard default).
     NO URL Rewrite Module needed.
     NO DNS changes needed.
     NO infra team needed.
-->
<configuration>
  <system.webServer>

    <handlers>
      <!--
        Route: GET /d?{token}  →  DownloadDoc handler
        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        path="d"       matches exactly the URL /d
        type="DownloadDoc" is the class in DownloadDoc.ashx
        preCondition="integratedMode" = IIS 7+ integrated pipeline (default)

        DownloadDoc reads token from Request.Url.Query ("?A3kZ9mQ1r" → "A3kZ9mQ1r")
      -->
      <add name="DocDownload"
           path="d"
           verb="GET"
           type="DownloadDoc"
           preCondition="integratedMode"
           resourceType="Unspecified"
           requireAccess="None" />
    </handlers>

  </system.webServer>
</configuration>
